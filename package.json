{
  "name": "hop",
  "description": "Self-hosted URL shortener with click statistics, for Cloudflare Workers or Docker",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/16bitsrl/hop"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "vite build && node scripts/build-node.mjs",
    "start:node": "node dist/node/server.mjs",
    "preview": "vite preview",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:node": "HOP_RUNTIME=node playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Links, users and click statistics."
      },
      "BLOBS": {
        "description": "Images you upload for the share preview of a link."
      },
      "APP_HOST": {
        "description": "Host of the admin app, without `https://`. Use your own domain (`hop.example.com`) or the `workers.dev` address of this Worker (`hop.<your-subdomain>.workers.dev`). Every other host pointed at the Worker serves short links."
      },
      "APP_URL": {
        "description": "Public URL of the admin app, e.g. `https://hop.example.com`."
      },
      "AUTH_SECRET": {
        "description": "At least 32 random characters (`openssl rand -base64 32`). Changing it signs everyone out."
      },
      "SETUP_TOKEN": {
        "description": "Asked for when you create the first account, so nobody else can claim the new installation. Choose any secret value."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.14",
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "i18next": "^26.5.12",
    "isbot": "^5.2.2",
    "lucide-react": "^1.66.0",
    "maxmind": "^5.0.7",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "worker-mailer": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oauth2-mock-server": "^9.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.156.0"
  }
}
